project "TestProject" {
    description "A test project for CLI verification"
    version "1.0.0"
    context "Testing .ac file support"
    architecture {
        pattern "Clean Architecture"
        layers "domain, application, infrastructure"
    }
}

platform rust {
    naming: snake_case
    optional: optional<T>
}

platform typescript {
    naming: camelCase
    optional: oneof<T, none>
}

alias UserId = uuid
alias Email = string [format: email, max: 255]
alias Priority = i32 [min: 1, max: 5]

build {
    output: "dist/"
    mcp_db: ".armature/spec.db"
}
